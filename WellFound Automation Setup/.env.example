# Wellfound Startup Discovery Agent - configuration example
#
# Copy to .env, or run:
#   .\.venv\Scripts\python.exe setup_discovery.py
#
# .env is git-ignored. Never commit real tokens or export files.

# --- Telegram -------------------------------------------------------------
# Create a bot with @BotFather -> /newbot. The token is read locally and is
# never printed by the agent, logs, or exports.
TELEGRAM_BOT_TOKEN=
# Numeric chat id (or @channel username) that may control the bot. Updates
# from every other chat are ignored.
TELEGRAM_CHAT_ID=

# --- Target companies -----------------------------------------------------
# Default: startups with 1-10 employees. A missing employee count is never
# treated as a match. A broad range (1-20) or an open-ended value (10+) is
# kept for review, not counted as confirmed.
STARTUP_TARGET_SIZE=1-10

# --- Permitted URL discovery ---------------------------------------------
# Off by default. Enable only for public sites whose terms and robots.txt
# permit your use. Wellfound/AngelList are always blocked.
STARTUP_ENABLE_URL_DISCOVERY=false
# Comma/semicolon-separated allow-list. Subdomains are included.
# Example: STARTUP_ALLOWED_DOMAINS=example.com,example.org
STARTUP_ALLOWED_DOMAINS=
# Optional public listing/profile URLs. They must be on an allowed domain.
STARTUP_SEED_URLS=
# At least one second between requests to the same host. The code enforces a
# floor of 1 second when URL discovery is enabled.
STARTUP_MIN_REQUEST_INTERVAL_SECONDS=3
STARTUP_REQUEST_TIMEOUT_SECONDS=20
STARTUP_MAX_RETRIES=2
STARTUP_MAX_URLS_PER_RUN=20
STARTUP_MAX_PAGE_MB=2

# --- Permitted open datasets (real company records) ----------------------
# DBpedia is a public dataset (CC BY-SA / CC0) with a documented SPARQL
# endpoint whose robots.txt allows /sparql. Its dbo:numberOfEmployees values
# are published headcounts taken from Wikipedia infoboxes, so the 1-10 filter
# works on real data. The dataset host must be allow-listed as well.
STARTUP_ENABLE_DATASETS=false
# Comma-separated source keys. Currently supported: dbpedia
STARTUP_DATASET_SOURCES=dbpedia
# Maximum company rows fetched per dataset query.
STARTUP_DATASET_LIMIT=250

# --- Optional daily discovery --------------------------------------------
# Local 24-hour time, shown in Telegram as 12-hour time. Blank = manual only.
# A daily run refreshes the datasets first, then the URL queue.
STARTUP_DAILY_RUN_AT=

# --- Wellfound through your own browser (optional) -----------------------
# Opens a visible Chromium with your signed-in session, applies Wellfound's
# "1-10 employees" filter and reads each company profile for its website.
# It never solves a CAPTCHA or defeats a login: a verification page stops
# the run. Wellfound's terms do not allow automated harvesting, so this is
# your own account and your own decision.
STARTUP_WELLFOUND_BROWSER=false
# Maximum company profiles to visit per run. This is only the default for a
# new install - the value is stored in the database and managed from the
# Telegram "Scan settings" panel.
STARTUP_WELLFOUND_MAX=25
# Persistent browser profile (keeps your own sign-in).
STARTUP_BROWSER_PROFILE=browser_profile
# Start a real Wellfound scan when the agent boots (an interrupted scan is
# resumed instead). Set to false if you only want the control panel.
STARTUP_AUTO_SCAN=true

# --- Public Wellfound scraper (startup_agent.cli scrape) ----------------
# Reads Wellfound's PUBLIC pages only: no login, no account, no session.
# The role list lives in a plain text file you can edit freely.
WFSCRAPE_ROLES_FILE=config/wf_scrape_roles.txt
# Pages to read per role page (20 companies per page).
WFSCRAPE_MAX_PAGES_PER_ROLE=3
# Maximum companies to collect in one run.
WFSCRAPE_MAX_COMPANIES=150
# The published company size to keep. 1-10 is the "1-10 employees" filter.
WFSCRAPE_TARGET_SIZE=1-10
# Delay between the plain-HTTP role page requests, in seconds.
WFSCRAPE_HTTP_DELAY_SECONDS=1.5
# Delay between the company profile pages in the browser, in seconds.
WFSCRAPE_BROWSER_DELAY_SECONDS=2.5
# true = no browser window. Run `cli scrape-prime` once first so the profile
# holds the clearance cookie that lets a headless browser through.
WFSCRAPE_HEADLESS=true
# A dedicated, unsigned-in browser profile. Keep it separate from
# browser_profile/, which the running agent owns.
WFSCRAPE_PROFILE=data/wfscrape_profile
WFSCRAPE_NAV_TIMEOUT_MS=45000
# How long to wait for Wellfound's security check to clear on its own.
WFSCRAPE_CHALLENGE_WAIT_SECONDS=30

# --- Storage / imports / exports -----------------------------------------
STARTUP_DB_PATH=data/startups.db
STARTUP_IMPORT_DIR=imports
STARTUP_EXPORT_DIR=exports
STARTUP_LOG_DIR=logs
STARTUP_MAX_IMPORT_MB=10
# 0 = no cap. Exports are timestamped and never overwrite an earlier file.
STARTUP_MAX_EXPORT_ROWS=0

# --- Diagnostics ----------------------------------------------------------
STARTUP_TELEGRAM_POLL_TIMEOUT=30
STARTUP_LOG_LEVEL=INFO
STARTUP_USER_AGENT=StartupDiscoveryAgent/1.0 (personal research; respects robots.txt)

# Legacy internship bot settings are preserved in docs/legacy_env.example.
# The new run.py does not import wfbot; its WF_* variables are ignored by the
# discovery agent and its old database remains at data/applications.db.
